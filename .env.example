# Explainer Studio — environment template
#
# Copy to .env and fill in the values you need:
#     cp .env.example .env
#
# NOTE: the package does NOT auto-load .env (there is no python-dotenv
# dependency). config.py reads os.environ directly, so export the file first:
#     set -a && source .env && set +a
#     explainer generate "photosynthesis" -o out.mp4
# or pass it straight to Docker:
#     docker run --env-file .env -v $PWD:/workspace explainer-studio generate "..." -o /workspace/out.mp4
#
# Precedence (see explainer/config.py): CLI args > env vars > ~/.explainer/config.toml > defaults.
# Every value below is OPTIONAL — the defaults (heuristic LLM + edge-tts)
# require no API keys at all.

# ---------------------------------------------------------------------------
# Pipeline settings (EXPLAINER_* — consumed by ExplainerConfig.resolve)
# ---------------------------------------------------------------------------

# LLM model string passed to litellm. Current strings (July 2026):
#   openai/gpt-5.6        openai/gpt-5.6-terra        openai/gpt-5.6-luna
#   anthropic/claude-opus-5   anthropic/claude-sonnet-5   anthropic/claude-haiku-4-5-20251001
#   gemini/gemini-3.1-pro-preview   gemini/gemini-3.6-flash   gemini/gemini-3.5-flash-lite
#   deepseek/deepseek-v4-pro  deepseek/deepseek-v4-flash  moonshot/kimi-k3
# Unset (or "heuristic") uses the offline heuristic provider — no API key.
# EXPLAINER_LLM=anthropic/claude-sonnet-5

# TTS provider: edge (default, free) | elevenlabs | azure | openai
# EXPLAINER_TTS=edge

# Voice ID for the chosen TTS provider. Unset uses the provider default.
# List options with: explainer voices
# EXPLAINER_VOICE=en-US-AriaNeural

# Frames per second for rendering. Default 15.
# EXPLAINER_FPS=15

# Output resolution. Default 720p.
# EXPLAINER_RESOLUTION=720p

# Keep the temp work dir (frames, audio, segments) after generation.
# Accepts 1/true/yes/on. Default false.
# EXPLAINER_KEEP_ARTIFACTS=false

# ---------------------------------------------------------------------------
# LLM API keys — only the one matching your EXPLAINER_LLM prefix is required.
# config.py raises ConfigError at startup if the matching key is missing.
# ---------------------------------------------------------------------------

# Prefixes: openai/, gpt
# OPENAI_API_KEY=sk-...

# Prefixes: anthropic/, claude
# ANTHROPIC_API_KEY=sk-ant-...

# Prefixes: gemini/, google — either name works, they are the same credential
# GOOGLE_API_KEY=...
# GEMINI_API_KEY=...

# Prefixes: moonshot/, kimi
# MOONSHOT_API_KEY=...

# Prefix: deepseek
# DEEPSEEK_API_KEY=...

# ---------------------------------------------------------------------------
# TTS API keys — required only for the matching EXPLAINER_TTS provider.
# The default "edge" provider needs none.
# ---------------------------------------------------------------------------

# EXPLAINER_TTS=elevenlabs
# ELEVENLABS_API_KEY=...

# EXPLAINER_TTS=azure
# AZURE_SPEECH_KEY=...
# Region is not read from the environment today — AzureTTSProvider defaults to
# "eastus" and takes `region=` as a constructor argument via the library API.
# AZURE_SPEECH_REGION=eastus

# EXPLAINER_TTS=openai   (reuses OPENAI_API_KEY above)
