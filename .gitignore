# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / build ----------------------------------------------------
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/
ENV/

